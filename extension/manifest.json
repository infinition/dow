{
  "manifest_version": 3,
  "name": "Dow - Image Downloader & Bookmarklets Suite",
  "version": "3.0.0",
  "description": "Bulk image downloader with advanced filters, plus a bookmarklet launcher that runs utility scripts on the active page.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "downloads",
    "scripting",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "images/*",
        "lib/*",
        "src/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dow Companion Suite",
    "default_icon": {
      "16": "dow.png",
      "32": "dow.png",
      "48": "dow.png",
      "128": "dow.png"
    }
  },
  "icons": {
    "16": "dow.png",
    "32": "dow.png",
    "48": "dow.png",
    "128": "dow.png"
  }
}
